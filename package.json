{
  "name": "digimon-partner-kit",
  "version": "2.0.0",
  "description": "Build your own Digimon-Partner Digivolution line.",
  "homepage": "https://furudbat.github.io/digimon-partner-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "format": "prettier --write .storybook src scripts/*.ts && eslint .storybook src scripts/*.ts --fix",
    "prettier:format": "prettier --write .storybook src scripts/*.ts",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,json}\"",
    "lint": "eslint src scripts/scraper.ts",
    "typecheck": "tsc --noEmit",
    "eslint:format": "eslint src scripts/scraper.ts --fix",
    "test": "jest test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "generate": "pnpm plop --plopfile ./.plop/plopfile.js",
    "scraper": "tsx scripts/scraper.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "clsx": "2.1.1",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-scroll": "^1.9.3",
    "use-debounce": "^10.1.1",
    "use-fit-text": "^2.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^25.9.5",
    "@types/random-useragent": "^0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-scroll": "^1.8.10",
    "babel-jest": "30.3.0",
    "baseline-browser-mapping": "^2.10.42",
    "cheerio": "1.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.7.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "plop": "4.0.5",
    "prettier": "3.8.2",
    "random-useragent": "^0.5.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "6.0.2"
  }
}
